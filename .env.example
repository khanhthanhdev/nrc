# =======================
# Root environment template
# Copy to `.env` for `docker compose` / local dev.
# NEVER commit the real `.env`.
# =======================

# --- Public domains (Caddy edge) ---
WEB_DOMAIN=s4vnrc.org
API_DOMAIN=api.s4vnrc.org
# ACME contact email for Let's Encrypt. Use a real, monitored mailbox.
ACME_EMAIL=ops@example.com

# --- Postgres ---
POSTGRES_DB=nrc_full
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-please
# Host port to publish the DB on (bind to 127.0.0.1 in compose)
POSTGRES_PORT=5432

# --- Server (apps/server) ---
SERVER_PORT=3001
DATABASE_URL=postgresql://postgres:change-me-please@db:5432/nrc_full
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Web (apps/web) ---
WEB_PORT=3000
VITE_API_URL=http://localhost:3001

# --- AWS / S3 (better-upload) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
