# =======================
# Root .dockerignore
# Used for monorepo-aware builds (context = repo root)
# Smaller context = faster builds + smaller layers
# =======================

# VCS
.git
.gitignore
.gitattributes
.github

# Dependencies (re-installed in container)
**/node_modules
.pnpm-store
.pnp
.pnp.js

# Build outputs (re-built in container)
**/dist
**/build
**/.output
**/.nitro
**/.turbo
**/.cache
**/*.tsbuildinfo

# Local env (NEVER ship secrets in images)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs
**/logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# Test artefacts
**/coverage
**/.nyc_output
**/test-results
**/playwright-report
**/.playwright

# Editor / OS
.vscode
.zed
.idea
.fallow
.claude
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Docker meta (don't recurse into ourselves)
**/Dockerfile*
**/.dockerignore
**/docker-compose*.yml
**/docker-compose*.yaml

# Misc
**/*.md
!README.md
release-manifest.json
output
plans
docs
scripts
